{
  "name": "@puff/desktop",
  "version": "0.1.3",
  "private": true,
  "description": "Puff desktop app (Electron + React).",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
