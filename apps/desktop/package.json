    "@modelcontextprotocol/sdk": "^1.32.1",
    "falkordb": "^6.8.0",
    "ignore": "^7.0.12",
    "ulid": "^3.0.2",
    "web-tree-sitter": "0.22.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@puff/core": "*",
    "@puff/mcp": "*",
    "@puff/shared": "*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
