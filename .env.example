# Copy to .env (gitignored). Read by docker compose and by Puff (CLI, MCP server, desktop app).

# FalkorDB connection
FALKORDB_URL=falkor://localhost:6379

# Host ports for docker compose. If 6379 is already used (e.g. a local Redis),
# set FALKORDB_PORT=6380 and FALKORDB_URL=falkor://localhost:6380
# FALKORDB_PORT=6379
# FALKORDB_BROWSER_PORT=3000

# Optional overrides
# PUFF_CONFIG=./puff.config.yaml
# PUFF_PROJECT=shop_api
# PUFF_WORKTREES=.puff/worktrees
