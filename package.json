{
  "name": "puff",
  "version": "0.1.0",
  "private": true,
  "description": "Shared, code-anchored graph memory for a team of coding agents, built on FalkorDB.",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/core",
    "packages/mcp",
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @puff/desktop",
    "dev:web": "npm run dev:web -w @puff/desktop",
    "build": "npm run build -w @puff/desktop",
    "build:desktop": "npm run package -w @puff/desktop",
    "puff": "tsx packages/core/src/cli.ts",
    "mcp": "tsx packages/mcp/src/index.ts",
    "chat": "tsx packages/mcp/src/chat-cli.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
